{
  // tsx config for scripts/verify-account-progress.ts ONLY (not part of typecheck).
  //
  // The suite renders the REAL PatientAccountProvider + PatientProvider (and
  // OnboardingProvider) under Node with react-test-renderer to prove the
  // account-backed progress slices: photo rail uploads + grid writes,
  // check-ins, stall-nudge flags, and onboarding/notification prefs — with
  // the demo persona untouched. Native-only bare specifiers are remapped to
  // the shared onboarding-gate stubs; @/lib/supabase becomes a session
  // emitter so the suite can sign in/out mid-test.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/lib/supabase": ["./scripts/live-diary-stubs/supabase.ts"],
      "@/*": ["./*"],
      "react-native": ["./scripts/onboarding-gate-stubs/react-native.ts"],
      "expo/fetch": ["./scripts/coach-stop-stubs/expo-fetch.ts"],
      "@expo/vector-icons": ["./scripts/onboarding-gate-stubs/expo-vector-icons.ts"],
      "expo-haptics": ["./scripts/onboarding-gate-stubs/expo-haptics.ts"],
      "expo-router": ["./scripts/onboarding-gate-stubs/expo-router.ts"],
      "react-native-safe-area-context": [
        "./scripts/onboarding-gate-stubs/react-native-safe-area-context.ts"
      ],
      "react-native-keyboard-controller": [
        "./scripts/onboarding-gate-stubs/react-native-keyboard-controller.ts"
      ],
      "@react-native-async-storage/async-storage": [
        "./scripts/onboarding-gate-stubs/async-storage.ts"
      ]
    }
  }
}
