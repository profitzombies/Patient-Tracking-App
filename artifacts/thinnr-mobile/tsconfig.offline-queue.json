{
  // tsx config for scripts/verify-offline-queue.ts ONLY (not part of typecheck).
  //
  // The suite renders the REAL PatientAccountProvider + PatientProvider under
  // Node with react-test-renderer to prove real-account mode: hydration from
  // the patient-data API, optimistic writes with rollback, account isolation,
  // and the demo persona staying byte-identical. Native-only bare specifiers
  // are remapped to the shared onboarding-gate stubs; @/lib/supabase becomes
  // a session-emitter fake so the suite can sign in/out mid-test.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/lib/supabase": ["./scripts/live-diary-stubs/supabase.ts"],
      "@/*": ["./*"],
      "react-native": ["./scripts/offline-queue-stubs/react-native.ts"],
      "expo/fetch": ["./scripts/coach-stop-stubs/expo-fetch.ts"],
      "@expo/vector-icons": ["./scripts/onboarding-gate-stubs/expo-vector-icons.ts"],
      "expo-haptics": ["./scripts/onboarding-gate-stubs/expo-haptics.ts"],
      "expo-router": ["./scripts/onboarding-gate-stubs/expo-router.ts"],
      "react-native-safe-area-context": [
        "./scripts/onboarding-gate-stubs/react-native-safe-area-context.ts"
      ],
      "react-native-keyboard-controller": [
        "./scripts/onboarding-gate-stubs/react-native-keyboard-controller.ts"
      ],
      "@react-native-async-storage/async-storage": [
        "./scripts/onboarding-gate-stubs/async-storage.ts"
      ]
    }
  }
}
