{
  // tsx config for scripts/verify-setup-wizard.tsx ONLY (not part of
  // typecheck). Renders the real practice-launch guard and setup wizard under
  // react-test-renderer with the a11y session/scope stubs, the DOM-free Radix
  // stand-ins, and the Stripe React/Connect stubs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/contexts/session": ["./scripts/a11y-stubs/session.ts"],
      "@/contexts/provider-scope": ["./scripts/a11y-stubs/provider-scope.ts"],
      "@/contexts/hq-data": ["./scripts/a11y-stubs/hq-data.ts"],
      "@/lib/supabase": ["./scripts/invite-stubs/supabase.ts"],
      "@/components/ui/select": ["./scripts/office-admin-stubs/select.tsx"],
      "@/components/ui/dialog": ["./scripts/office-admin-stubs/dialog.tsx"],
      "@/components/ui/alert-dialog": ["./scripts/office-admin-stubs/alert-dialog.tsx"],
      "@/components/billing/ConnectEmbed": ["./scripts/a11y-stubs/connect-embed.tsx"],
      "@stripe/react-stripe-js": ["./scripts/a11y-stubs/stripe-react.tsx"],
      "@stripe/stripe-js": ["./scripts/a11y-stubs/stripe-js.ts"],
      "@/*": ["./src/*"]
    }
  }
}
