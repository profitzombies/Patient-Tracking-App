{
  // tsx config for scripts/verify-guided-photos.ts ONLY (not part of typecheck).
  //
  // The suite runs the REAL GuidedPhotoSession component tree, the real
  // PatientContext, the real detection/probe/upload libs, and the real
  // Progress + Check-in screens under Node, so native-only imports remap to
  // Node stubs and JSX compiles with the automatic runtime.
  //
  // Guided-local stubs: expo-camera (adds onCameraReady + a scriptable
  // capture handler the probe loop needs), expo-sensors, expo-audio,
  // expo-asset, react-native-svg, and the two data modules whose static
  // require() calls pull binary assets (pose .jpgs, countdown .wavs).
  // Everything else reuses the meal-photo / label-scan / onboarding-gate
  // stubs, so the three suites keep one behavior per module.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/components/ui/AppModal": ["./scripts/meal-photo-stubs/app-modal.ts"],
      "@/data/guided-photo-images": ["./scripts/guided-photo-stubs/guided-photo-images.ts"],
      "@/data/guided-photo-sounds": ["./scripts/guided-photo-stubs/guided-photo-sounds.ts"],
      "@/data/guided-voice-clips": ["./scripts/guided-photo-stubs/guided-voice-clips.ts"],
      "@/data/recipe-images": ["./scripts/guided-photo-stubs/recipe-images.ts"],
      "@/*": ["./*"],
      "react-native": ["./scripts/guided-photo-stubs/react-native.ts"],
      "react-native-svg": ["./scripts/guided-photo-stubs/react-native-svg.ts"],
      "react-native-keyboard-controller": [
        "./scripts/guided-photo-stubs/react-native-keyboard-controller.ts"
      ],
      "expo/fetch": ["./scripts/meal-photo-stubs/expo-fetch.ts"],
      "@react-native-async-storage/async-storage": ["./scripts/meal-photo-stubs/async-storage.ts"],
      "expo-haptics": ["./scripts/meal-photo-stubs/expo-haptics.ts"],
      "expo-router": ["./scripts/meal-photo-stubs/expo-router.ts"],
      "expo-camera": ["./scripts/guided-photo-stubs/expo-camera.ts"],
      "expo-sensors": ["./scripts/guided-photo-stubs/expo-sensors.ts"],
      "expo-speech": ["./scripts/guided-photo-stubs/expo-speech.ts"],
      "expo-audio": ["./scripts/guided-photo-stubs/expo-audio.ts"],
      "expo-asset": ["./scripts/guided-photo-stubs/expo-asset.ts"],
      "expo-image": ["./scripts/label-scan-stubs/expo-image.ts"],
      "expo-image-picker": ["./scripts/label-scan-stubs/expo-image-picker.ts"],
      "expo-image-manipulator": ["./scripts/label-scan-stubs/expo-image-manipulator.ts"],
      "@expo/vector-icons": ["./scripts/onboarding-gate-stubs/expo-vector-icons.ts"],
      "react-native-safe-area-context": ["./scripts/onboarding-gate-stubs/react-native-safe-area-context.ts"]
    }
  }
}
