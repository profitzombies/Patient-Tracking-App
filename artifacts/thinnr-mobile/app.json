{
  "expo": {
    "name": "THINNR Mobile Operations",
    "slug": "thinnr-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_2.png",
    "scheme": "thinnr-mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "THINNR uses Face ID only to unlock the signed-in app on this device.",
        "NSHealthShareUsageDescription": "THINNR reads only the weight and step measurements you approve for your patient account.",
        "NSHealthUpdateUsageDescription": "THINNR does not write health data."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon_2.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon_2.png",
          "resizeMode": "contain",
          "backgroundColor": "#eef1f6"
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "THINNR uses the camera to photograph meals, menus, and nutrition labels for the AI coach.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "THINNR shows your recent photos so you can attach one for the AI coach."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "THINNR reads the phone's tilt so guided progress photos line up at the same angle every week."
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "defaultChannel": "medication-reminders"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow THINNR to use Face ID only as a convenient local app unlock."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "react-native-health-connect",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.thinnr.mobile",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
