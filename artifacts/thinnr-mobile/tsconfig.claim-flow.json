{
  // tsx config for scripts/verify-claim-flow.ts ONLY (not part of typecheck).
  //
  // The suite renders the REAL claim-account screen (app/claim-account.tsx,
  // OnboardingFields, LedgerPrimitives, AppModeContext) under Node with
  // react-test-renderer, so every native-only bare specifier in that import
  // graph is remapped to a Node stub (shared with the onboarding-gate suite)
  // and JSX is compiled with the automatic runtime. The one claim-specific
  // stub replaces @/lib/supabase so sign-in is recorded instead of hitting
  // GoTrue; the stub re-exports the REAL normalizePhone/describeAuthError.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/lib/supabase": ["./scripts/claim-flow-stubs/supabase.ts"],
      "@/*": ["./*"],
      "react-native": ["./scripts/onboarding-gate-stubs/react-native.ts"],
      "expo/fetch": ["./scripts/coach-stop-stubs/expo-fetch.ts"],
      "@expo/vector-icons": ["./scripts/onboarding-gate-stubs/expo-vector-icons.ts"],
      "expo-haptics": ["./scripts/onboarding-gate-stubs/expo-haptics.ts"],
      "expo-router": ["./scripts/onboarding-gate-stubs/expo-router.ts"],
      "react-native-safe-area-context": [
        "./scripts/onboarding-gate-stubs/react-native-safe-area-context.ts"
      ],
      "react-native-keyboard-controller": [
        "./scripts/onboarding-gate-stubs/react-native-keyboard-controller.ts"
      ],
      "@react-native-async-storage/async-storage": [
        "./scripts/onboarding-gate-stubs/async-storage.ts"
      ]
    }
  }
}
