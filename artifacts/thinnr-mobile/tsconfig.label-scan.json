{
  // tsx config for scripts/verify-label-scan.ts ONLY (not part of typecheck).
  //
  // The suite renders the REAL create-food screen (with its label-scan
  // section) plus the real AppMode/Patient providers under Node with
  // react-test-renderer, so every native-only bare specifier in that import
  // graph is remapped to a Node stub and JSX is compiled with the automatic
  // runtime. Most stubs are shared with the onboarding-gate suite;
  // label-scan-local stand-ins cover the picker/manipulator/image modules
  // and an expo-router with search params + Redirect.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "react-native": ["./scripts/label-scan-stubs/react-native.ts"],
      "expo-router": ["./scripts/label-scan-stubs/expo-router.ts"],
      "expo-image": ["./scripts/label-scan-stubs/expo-image.ts"],
      "expo-image-picker": ["./scripts/label-scan-stubs/expo-image-picker.ts"],
      "expo-image-manipulator": ["./scripts/label-scan-stubs/expo-image-manipulator.ts"],
      "expo/fetch": ["./scripts/coach-stop-stubs/expo-fetch.ts"],
      "@expo/vector-icons": ["./scripts/onboarding-gate-stubs/expo-vector-icons.ts"],
      "expo-haptics": ["./scripts/onboarding-gate-stubs/expo-haptics.ts"],
      "react-native-safe-area-context": [
        "./scripts/onboarding-gate-stubs/react-native-safe-area-context.ts"
      ],
      "react-native-keyboard-controller": [
        "./scripts/onboarding-gate-stubs/react-native-keyboard-controller.ts"
      ],
      "@react-native-async-storage/async-storage": [
        "./scripts/onboarding-gate-stubs/async-storage.ts"
      ]
    }
  }
}
