{
  // tsx config for scripts/verify-progress-session.ts ONLY (not part of
  // typecheck).
  //
  // The suite drives the REAL guided-session pieces under Node: the pure
  // session reducer and no-AI photo analysis, the real session-tone WAVs,
  // the real upload client, and full react-test-renderer runs of
  // GuidedSessionSurface inside the real PatientProvider on the web
  // (simulated-camera) path. Native-only imports are remapped to stubs;
  // most are reused from the meal-photo / label-scan / onboarding-gate
  // suites, with progress-session-local stubs for sensors, speech, audio,
  // svg, the pose-illustration requires (tsx cannot load .jpg), and an
  // async-storage variant whose backing store the suite can inspect to
  // stage legacy patient snapshots.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/components/patient/pose-images": ["./scripts/progress-session-stubs/pose-images.ts"],
      "@/*": ["./*"],
      "react-native": ["./scripts/meal-photo-stubs/react-native.ts"],
      "expo/fetch": ["./scripts/meal-photo-stubs/expo-fetch.ts"],
      "@react-native-async-storage/async-storage": [
        "./scripts/progress-session-stubs/async-storage.ts"
      ],
      "expo-haptics": ["./scripts/meal-photo-stubs/expo-haptics.ts"],
      "expo-router": ["./scripts/meal-photo-stubs/expo-router.ts"],
      "expo-camera": ["./scripts/meal-photo-stubs/expo-camera.ts"],
      "expo-image": ["./scripts/label-scan-stubs/expo-image.ts"],
      "expo-image-manipulator": ["./scripts/label-scan-stubs/expo-image-manipulator.ts"],
      "@expo/vector-icons": ["./scripts/onboarding-gate-stubs/expo-vector-icons.ts"],
      "react-native-safe-area-context": [
        "./scripts/onboarding-gate-stubs/react-native-safe-area-context.ts"
      ],
      "expo-sensors": ["./scripts/progress-session-stubs/expo-sensors.ts"],
      "expo-speech": ["./scripts/progress-session-stubs/expo-speech.ts"],
      "expo-audio": ["./scripts/progress-session-stubs/expo-audio.ts"],
      "react-native-svg": ["./scripts/progress-session-stubs/react-native-svg.ts"]
    }
  }
}
