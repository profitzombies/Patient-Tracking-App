{
  // tsx config for scripts/verify-body-measurements.tsx ONLY (not part of
  // typecheck — tsconfig.json includes src/**/* alone).
  //
  // The suite renders the REAL patient record page (demo and live) under
  // react-test-renderer against a scripted global fetch, so the session /
  // provider scope contexts are the a11y stubs and lib/supabase is the
  // invite-suite stub (it can pose as a signed-in staffer). Exact path keys
  // win over the '@/*' wildcard; every other '@/…' import resolves to real code.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/contexts/session": ["./scripts/a11y-stubs/session.ts"],
      "@/contexts/provider-scope": ["./scripts/a11y-stubs/provider-scope.ts"],
      "@/lib/supabase": ["./scripts/invite-stubs/supabase.ts"],
      "@/*": ["./src/*"]
    }
  }
}
