{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "harness:meal-read": "tsx scripts/meal-read-harness/run.ts",
    "harness:bloodwork-benchmark": "tsx scripts/bloodwork-benchmark/run.ts",
    "harness:bloodwork-accuracy": "tsx scripts/bloodwork-benchmark/accuracy.ts",
    "test:usda-catalog-seed": "tsx scripts/verify-usda-catalog-seed.ts",
    "test:patient-snapshot-sql": "vitest run src/routes/patient-data.sql.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@napi-rs/canvas": "^0.1.80",
    "@workspace/api-zod": "workspace:*",
    "@workspace/app-usage-insights": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/email-templates": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "mammoth": "^1.12.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "unpdf": "^1.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "jszip": "^3.10.1",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.11"
  }
}
