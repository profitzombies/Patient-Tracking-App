modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "demo-parity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "approved-foods"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "diary-undo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "photo-backfill"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "diary-copy"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "diary-edit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "custom-food-undo"

[[workflows.workflow]]
name = "demo-parity"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/thinnr-operations run test:parity"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "approved-foods"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/thinnr-mobile run test:approved-foods"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "diary-undo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/thinnr-mobile run test:diary-undo"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "photo-backfill"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/thinnr-mobile run test:photo-backfill"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "diary-copy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/thinnr-mobile run test:diary-copy"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "diary-edit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/thinnr-mobile run test:diary-edit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "custom-food-undo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/thinnr-mobile run test:custom-food-undo"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
