modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "demo-parity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "approved-foods"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "diary-undo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "photo-backfill"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "diary-copy"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "diary-edit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "custom-food-undo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "coach-stop"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "onboarding-hints"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "photo-remove"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "onboarding-gate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "recipe-nutrition"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "training-invariants"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "hq-conversations"

[[workflows.workflow]]
name = "demo-parity"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/thinnr-operations run test:parity"

[workflows.workflow.metadata]
isValidation = true

