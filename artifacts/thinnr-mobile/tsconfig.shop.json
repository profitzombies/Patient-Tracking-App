{
  // tsx config for the shop suites ONLY (scripts/verify-shop.tsx,
  // verify-product-page.tsx, verify-cart-math.ts, verify-checkout.tsx; not
  // part of typecheck). Renders the REAL shop / product / cart / checkout
  // screens with the REAL account, patient, and cart providers under
  // react-test-renderer. Native-only specifiers map to Node stand-ins and the
  // platform-split card entry maps to a scripted fake so the suites can
  // decide what "Stripe" answers. Exact path keys win over the '@/*' wildcard.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/lib/supabase": ["./scripts/live-diary-stubs/supabase.ts"],
      "@/components/shop/StripeCardEntry": ["./scripts/shop-stubs/StripeCardEntry.tsx"],
      "@/data/product-images": ["./scripts/chat-account-stubs/product-images.ts"],
      "@/*": ["./*"],
      "react-native": ["./scripts/shop-stubs/react-native.ts"],
      "expo/fetch": ["./scripts/coach-stop-stubs/expo-fetch.ts"],
      "expo-image": ["./scripts/label-scan-stubs/expo-image.ts"],
      "expo-web-browser": ["./scripts/patient-billing-stubs/expo-web-browser.ts"],
      "@expo/vector-icons": ["./scripts/onboarding-gate-stubs/expo-vector-icons.ts"],
      "expo-haptics": ["./scripts/onboarding-gate-stubs/expo-haptics.ts"],
      "expo-router": ["./scripts/provider-training-stubs/expo-router.ts"],
      "react-native-safe-area-context": ["./scripts/onboarding-gate-stubs/react-native-safe-area-context.ts"],
      "react-native-keyboard-controller": ["./scripts/onboarding-gate-stubs/react-native-keyboard-controller.ts"],
      "@react-native-async-storage/async-storage": ["./scripts/onboarding-gate-stubs/async-storage.ts"]
    }
  }
}
