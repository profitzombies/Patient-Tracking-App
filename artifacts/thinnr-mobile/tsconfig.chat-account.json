{
  // tsx config for scripts/verify-chat-account.ts ONLY (not part of typecheck).
  //
  // The suite renders the REAL PatientAccountProvider + PatientProvider +
  // CoachChatProvider (and the real support-chat screen) under Node with
  // react-test-renderer to prove per-account chat persistence: hydration of
  // the stored transcript, finalized-message appends, restart-resume, and
  // the demo persona staying byte-identical. Same stub set as the
  // live-diary suite, plus expo-router hooks and a reanimated shim for the
  // support screen's thinking indicator.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/lib/supabase": ["./scripts/live-diary-stubs/supabase.ts"],
      "@/*": ["./*"],
      "react-native": ["./scripts/onboarding-gate-stubs/react-native.ts"],
      "expo/fetch": ["./scripts/coach-stop-stubs/expo-fetch.ts"],
      "@expo/vector-icons": ["./scripts/onboarding-gate-stubs/expo-vector-icons.ts"],
      "expo-haptics": ["./scripts/onboarding-gate-stubs/expo-haptics.ts"],
      "expo-router": ["./scripts/chat-account-stubs/expo-router.ts"],
      "react-native-reanimated": ["./scripts/chat-account-stubs/react-native-reanimated.ts"],
      "react-native-safe-area-context": [
        "./scripts/onboarding-gate-stubs/react-native-safe-area-context.ts"
      ],
      "react-native-keyboard-controller": [
        "./scripts/onboarding-gate-stubs/react-native-keyboard-controller.ts"
      ],
      "@react-native-async-storage/async-storage": [
        "./scripts/onboarding-gate-stubs/async-storage.ts"
      ]
    }
  }
}
