[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY = "sb_publishable_x_jS0otm2b7K8wc_HLXbUg_6Dq3_Haz"
EXPO_PUBLIC_SUPABASE_URL = "https://xkdhmqexlvkipwgkaiyk.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY = "sb_publishable_x_jS0otm2b7K8wc_HLXbUg_6Dq3_Haz"
VITE_SUPABASE_URL = "https://xkdhmqexlvkipwgkaiyk.supabase.co"
TRAINING_OBJECT_DIR = "/replit-objstore-2a712e1c-f89a-4c61-95b8-d3cd5a9804ea/.private"
CLAIM_EMAIL_DELIVERY_MODE = "live"
CLAIM_SMS_DELIVERY_MODE = "live"
CLAIM_EMAIL_FROM = "THINNR Dashboard <no-reply@appnotifications.thinnrweightloss.com>"

[nix]
channel = "stable-25_05"
packages = ["ffmpeg"]

[objectStorage]
defaultBucketID = "replit-objstore-2a712e1c-f89a-4c61-95b8-d3cd5a9804ea"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19713
externalPort = 80
exposeLocalhost = true

[[ports]]
