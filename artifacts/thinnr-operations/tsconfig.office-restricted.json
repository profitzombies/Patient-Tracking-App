{
  // tsx config for scripts/verify-office-restricted.tsx only.
  // The suite renders the real restricted route gate, explanation screen and
  // banner under react-test-renderer; only the session/provider-scope contexts
  // and the Supabase client behind the office API are stubbed.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/contexts/session": ["./scripts/a11y-stubs/session.ts"],
      "@/lib/supabase": ["./scripts/invite-stubs/supabase.ts"],
      "@/*": ["./src/*"]
    }
  }
}
