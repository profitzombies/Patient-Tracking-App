{
  // tsx config for scripts/verify-training-a11y.tsx ONLY (not part of
  // typecheck — tsconfig.json includes src/**/* alone).
  //
  // The suite renders the REAL OfficeTraining / OfficeTeammate pages with
  // react-test-renderer under Node, so the three context modules that reach
  // Supabase / import.meta.env are remapped to controllable stubs. Exact
  // path keys win over the '@/*' wildcard; every other '@/…' import
  // resolves to the real code. Same pattern as the mobile training suite
  // (thinnr-mobile/tsconfig.provider-training.json).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/contexts/training-data": ["./scripts/a11y-stubs/training-data.ts"],
      "@/contexts/session": ["./scripts/a11y-stubs/session.ts"],
      "@/contexts/provider-scope": ["./scripts/a11y-stubs/provider-scope.ts"],
      "@/lib/supabase": ["./scripts/a11y-stubs/supabase.ts"],
      "@/*": ["./src/*"]
    }
  }
}
