{
  // tsx config for scripts/verify-meal-photo.ts ONLY (not part of typecheck).
  //
  // The suite runs the real CoachChatContext + PatientContext + lib code —
  // and, for the in-app camera flows, the real FoodCameraSurface and
  // MealPhotoButton component trees — under Node, so native-only imports are
  // remapped to Node stubs and JSX is compiled with the automatic runtime
  // (the inherited "react-native" jsx setting would leave JSX untransformed).
  //
  // react-native gains host components via the meal-photo stub (re-exporting
  // the shared onboarding-gate one, plus ActivityIndicator and a captured
  // Linking). expo/fetch is a call-time delegate so scripted fetches keep
  // working when a scenario flips Platform.OS to 'ios'. Picker, manipulator,
  // and expo-image stubs are reused from the label-scan suite; camera and
  // media-library stubs are meal-photo-local. AppModal is stubbed directly
  // (its WebFitShell wrapper is meaningless under Node): children render
  // only while `visible`, so testID presence tracks modal state.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/components/ui/AppModal": ["./scripts/meal-photo-stubs/app-modal.ts"],
      "@/*": ["./*"],
      "react-native": ["./scripts/meal-photo-stubs/react-native.ts"],
      "expo/fetch": ["./scripts/meal-photo-stubs/expo-fetch.ts"],
      "@react-native-async-storage/async-storage": ["./scripts/meal-photo-stubs/async-storage.ts"],
      "expo-haptics": ["./scripts/meal-photo-stubs/expo-haptics.ts"],
      "expo-router": ["./scripts/meal-photo-stubs/expo-router.ts"],
      "expo-camera": ["./scripts/meal-photo-stubs/expo-camera.ts"],
      "expo-media-library": ["./scripts/meal-photo-stubs/expo-media-library.ts"],
      "expo-media-library/legacy": ["./scripts/meal-photo-stubs/expo-media-library.ts"],
      "expo-image": ["./scripts/label-scan-stubs/expo-image.ts"],
      "expo-image-picker": ["./scripts/label-scan-stubs/expo-image-picker.ts"],
      "expo-image-manipulator": ["./scripts/label-scan-stubs/expo-image-manipulator.ts"],
      "@expo/vector-icons": ["./scripts/onboarding-gate-stubs/expo-vector-icons.ts"],
      "react-native-safe-area-context": ["./scripts/onboarding-gate-stubs/react-native-safe-area-context.ts"]
    }
  }
}
